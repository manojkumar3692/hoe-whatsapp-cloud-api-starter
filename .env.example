NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

META_WHATSAPP_TOKEN=EAAG...YOUR_PERMANENT_OR_TEMP_TOKEN
META_PHONE_NUMBER_ID=123456789
META_WABA_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID
META_VERIFY_TOKEN=hoe_verify_12345
META_API_VERSION=v23.0

# Read-only Meta Ads integration (separate from WhatsApp access).
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=v23.0

ADMIN_PASSWORD=change-this-password

# Shiprocket API user (Settings > API > Add New API User)
SHIPROCKET_ENABLED=false
SHIPROCKET_API_EMAIL=your-dedicated-api-user@example.com
SHIPROCKET_API_PASSWORD=your-api-user-password-or-key
# Optional: only needed when the same order ID exists in multiple channels
# SHIPROCKET_CHANNEL_ID=12345
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# Abandoned cart reminders (see /api/checkout-sessions/send-abandoned-cart-reminders)
CRON_SECRET=generate-a-random-32-char-secret
META_ABANDONED_CART_TEMPLATE=your-approved-cart-recovery-template-name
META_ABANDONED_CART_LANGUAGE=en
STOREFRONT_PRODUCT_PATH_PREFIX=products

# Image-header template variant (see abandoned_cart_recovery_v2 on /templates)
META_APP_ID=your-meta-developer-app-id
META_ABANDONED_CART_HEADER_IS_IMAGE=false
ABANDONED_CART_FALLBACK_IMAGE_URL=https://.../banner.jpg

# Opt-in order push notifications (see docs/mobile-and-push.md)
# Generate a pair once: npx web-push generate-vapid-keys --json
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:operations@example.com
# Random secret shared only with the Supabase order_push_events INSERT webhook
PUSH_WEBHOOK_SECRET=
